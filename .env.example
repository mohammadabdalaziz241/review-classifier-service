# Copy to .env (never commit .env) and adjust. docker compose reads it automatically.

# ---- the model baked into the image (build time) -----------------------------
# The project's sentiment model, pinned to the commit that was verified:
MODEL_ID=Mohammadeeu20/besstie-roberta-sentiment
MODEL_REVISION=43da49621dc65cdd7cd11f77c8c2e7eb13d06cbb
# The sarcasm model instead:
# MODEL_ID=Mohammadeeu20/besstie-roberta-sarcasm
# MODEL_REVISION=dedc10bff5817a4a84f0500150b85b99a4225ecb
# A checkpoint directory under models/ instead of the Hub:
# MODEL_ID=/opt/models/my-checkpoint
# MODEL_REVISION=
# No model at all (keyword baseline, for trying the stack quickly):
# MODEL_BACKEND=dummy

# ---- runtime ------------------------------------------------------------------
POSTGRES_PASSWORD=change-me
API_PORT=8000
LOG_LEVEL=info
